{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dayline",
  "version": "0.3.6",
  "identifier": "com.dayline.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev --workspace @dayline/web",
      "cwd": "../.."
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": {
      "script": "npm run build --workspace @dayline/web",
      "cwd": "../.."
    },
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dayline",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first task and time management",
    "longDescription": "A local-first task and time management app with no account and no subscription."
  }
}
